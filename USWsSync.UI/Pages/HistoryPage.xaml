<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="USWsSync_UI.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:USWsSync_UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,14,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fila 0: Encabezado Limpio sin Botones Duplicados -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock Text="Historial de Auditoría" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Trazabilidad histórica de sincronizaciones, deltas modificados y ventana de datos de Dobra ERP." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Fila 1: Tarjetas KPI de Auditoría -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Total Sincronizaciones -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="Sincronizaciones en Periodo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TxtKpiTotalRuns" Text="--" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtKpiTotalRunsSub" Text="Ciclos registrados" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- KPI 2: Sincronizaciones Exitosas -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="Sincronizaciones Exitosas" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TxtKpiSuccessRuns" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="TxtKpiSuccessRunsSub" Text="100% efectividad" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- KPI 3: Sincronizaciones con Incidencias -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="Con Incidencias" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TxtKpiErrorRuns" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Name="TxtKpiErrorRunsSub" Text="Errores o avisos" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- KPI 4: Registros Transferidos -->
            <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="Registros Transferidos" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TxtKpiTotalRecords" Text="--" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtKpiTotalRecordsSub" Text="Filas totales del periodo" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fila 2: Barra de Filtros Responsiva (Estructura en 2 Filas sin Desbordamiento) -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Subfila 0: Criterios Maestros de Fecha, Flujo, Estado y Botón Filtrar siempre visible a la derecha -->
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Fecha Desde -->
                    <CalendarDatePicker x:Name="DpFromDate" Grid.Column="0" Header="Fecha Desde:" HorizontalAlignment="Stretch" FontSize="12" DateChanged="DpDate_DateChanged" />

                    <!-- Fecha Hasta -->
                    <CalendarDatePicker x:Name="DpToDate" Grid.Column="1" Header="Fecha Hasta:" HorizontalAlignment="Stretch" FontSize="12" DateChanged="DpDate_DateChanged" />

                    <!-- Flujo / Dirección -->
                    <ComboBox x:Name="CmbDirection" Grid.Column="2" Header="Flujo:" HorizontalAlignment="Stretch" SelectedIndex="0" FontSize="12" SelectionChanged="Cmb_SelectionChanged">
                        <ComboBoxItem Content="Todos los flujos" Tag="All" />
                        <ComboBoxItem Content="Descarga (Nube a ERP)" Tag="Download" />
                        <ComboBoxItem Content="Subida (ERP a Nube)" Tag="Upload" />
                    </ComboBox>

                    <!-- Estado -->
                    <ComboBox x:Name="CmbStatus" Grid.Column="3" Header="Estado:" HorizontalAlignment="Stretch" SelectedIndex="0" FontSize="12" SelectionChanged="Cmb_SelectionChanged">
                        <ComboBoxItem Content="Todos los estados" Tag="All" />
                        <ComboBoxItem Content="Solo Exitosas" Tag="Success" />
                        <ComboBoxItem Content="Con Advertencias" Tag="Warning" />
                        <ComboBoxItem Content="Con Errores" Tag="Error" />
                    </ComboBox>

                    <!-- Botón Rápido "Hoy" -->
                    <Button Grid.Column="4" Click="BtnToday_Click" VerticalAlignment="Bottom" Style="{StaticResource DefaultButtonStyle}" Padding="12,6" Margin="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE787;" FontSize="11" />
                            <TextBlock Text="Hoy" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Principal "Filtrar / Consultar" (Anclado a la derecha, garantizado visible) -->
                    <Button Grid.Column="6" Click="BtnApplyFilters_Click" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Padding="16,6" Margin="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71C;" FontSize="12" />
                            <TextBlock Text="Filtrar" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Subfila 1: Buscador de Tabla, Rango Horario Compacto y Casilla de Solo Cambios -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Buscador de tabla modificada (ancho flexible *) -->
                    <TextBox x:Name="TxtSearchTable" Grid.Column="0" PlaceholderText="Buscar por tabla modificada (ej. VEN_FACTURAS, CXC_CLIENTES)..." FontSize="12" VerticalAlignment="Center" KeyDown="TxtSearchTable_KeyDown">
                        <TextBox.Header>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE721;" FontSize="10" />
                                <TextBlock Text="Búsqueda por tabla:" FontSize="10" />
                            </StackPanel>
                        </TextBox.Header>
                    </TextBox>

                    <!-- Rango Horario Compacto -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,0,4,2">
                        <CheckBox x:Name="ChkFilterTime" Content="Hora específica" FontSize="12" Checked="ChkFilterTime_CheckChanged" Unchecked="ChkFilterTime_CheckChanged" />
                        <TimePicker x:Name="TpFromTime" ClockIdentifier="24HourClock" IsEnabled="False" TimeChanged="TpTime_TimeChanged" />
                        <TextBlock Text="a" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TimePicker x:Name="TpToTime" ClockIdentifier="24HourClock" IsEnabled="False" TimeChanged="TpTime_TimeChanged" />
                    </StackPanel>

                    <!-- Check Solo Cambios o Incidencias -->
                    <CheckBox x:Name="ChkOnlyChanges" Grid.Column="2" Content="Solo con modificaciones o incidencias" IsChecked="True" FontSize="12" VerticalAlignment="Bottom" Checked="ChkOnlyChanges_CheckChanged" Unchecked="ChkOnlyChanges_CheckChanged" Margin="0,0,0,2" />
                </Grid>
            </Grid>
        </Border>

        <!-- Fila 3: Maestro - Detalle -->
        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Maestro: Lista de Sincronizaciones -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Encabezado de la lista -->
                    <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Historial de Sincronizaciones" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                            <TextBlock x:Name="TxtRunCount" Grid.Column="1" Text="0 registros" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- ListView de Sincronizaciones con Ventana de Datos -->
                    <ListView x:Name="LvRuns" Grid.Row="1" SelectionMode="Single" SelectionChanged="LvRuns_SelectionChanged" Padding="6,6">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SyncRunViewModel">
                                <Border Background="{x:Bind CardBackground}" 
                                        BorderBrush="{x:Bind CardBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="12,8">
                                    <Grid RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Fila 0: Badges (Estado, Dirección, Origen) -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Badge de Estado -->
                                            <Border Grid.Column="0" Background="{x:Bind StatusBackground}" BorderBrush="{x:Bind StatusBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="10" Foreground="{x:Bind StatusForeground}" />
                                                    <TextBlock Text="{x:Bind StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind StatusForeground}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Badges de Dirección y Origen -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="{x:Bind DirectionGlyph}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind DirectionText}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="{x:Bind TriggerGlyph}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind TriggerText}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Fila 1: Hora exacta de Ejecución Técnica y Duración -->
                                        <Grid Grid.Row="1" Margin="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FormattedDate}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind FormattedTime}" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind DurationText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Fila 2: Ventana de Datos / Corte ERP (Dato de Negocio) -->
                                        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,1,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE787;" FontSize="9" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind DataWindowSummary}" FontSize="10.5" FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Fila 3: Resumen de Deltas y Errores -->
                                        <Grid Grid.Row="3" Margin="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind ChangesSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ErrorTablesText}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind ErrorVisibility}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Estado Vacío -->
                    <StackPanel x:Name="PnlNoRuns" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed" Padding="20">
                        <FontIcon Glyph="&#xE9CE;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No se encontraron sincronizaciones" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Ajuste el rango de fechas o los filtros." FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detalle: Panel de la sincronización seleccionada -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                <Grid>
                    <!-- Prompt cuando no hay selección -->
                    <StackPanel x:Name="PnlSelectRunPrompt" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Visible">
                        <FontIcon Glyph="&#xE81C;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Seleccione una sincronización para auditar" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Consulte el momento exacto del proceso, el rango de corte contable afectado y el detalle de tablas y errores." FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
                    </StackPanel>

                    <!-- Detalle Completo de la Sincronización -->
                    <Grid x:Name="PnlRunDetail" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabecera de la sincronización seleccionada con Tarjetas Gemelas -->
                        <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="16,12">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Fila 0: Run ID, Estado y Botón de Copia -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border x:Name="BdDetailStatus" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock x:Name="TxtDetailStatus" Text="EXITOSA" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock x:Name="TxtDetailRunId" Text="ID: -- · RUN-ID: --" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="BtnCopyRunSummary_Click" Padding="10,4" Style="{StaticResource DefaultButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                            <TextBlock Text="Copiar Auditoría" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Fila 1: Tarjetas Gemelas (Ejecución Técnica vs Período de Información Afectada) -->
                                <Grid Grid.Row="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Tarjeta A: Ejecución del Sincronizador (Proceso) -->
                                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Ejecución del Sincronizador" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                            <Grid ColumnSpacing="8" RowSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Inicio:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="TxtDetailStartTime" Grid.Row="0" Grid.Column="1" Text="--" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Fin:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="TxtDetailEndTime" Grid.Row="1" Grid.Column="1" Text="--" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Duración:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="TxtDetailDuration" Grid.Row="2" Grid.Column="1" Text="--" FontSize="10.5" FontWeight="SemiBold" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tarjeta B: Período de Información Afectada (Corte Dobra ERP) -->
                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Período de Información (Corte ERP)" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                            <Grid ColumnSpacing="8" RowSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Desde:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="TxtDetailDataFrom" Grid.Row="0" Grid.Column="1" Text="--" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Hasta:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="TxtDetailDataTo" Grid.Row="1" Grid.Column="1" Text="--" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cobertura:" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="TxtDetailCoverage" Grid.Row="2" Grid.Column="1" Text="--" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Panel de Error Global (si hubo fallo a nivel lote) -->
                        <Border x:Name="BdGlobalError" Grid.Row="1" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="0,0,0,1" Padding="16,8" Visibility="Collapsed">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xEA39;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Incidencia Global en la Sincronización" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock x:Name="TxtGlobalErrorMessage" Text="--" FontSize="11" TextWrapping="Wrap" MaxLines="2" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="BtnViewGlobalError_Click" Padding="8,3" Style="{StaticResource DefaultButtonStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="Ver Detalle" FontSize="10" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Detalle de Tablas Afectadas (Deltas) -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Subcabecera -->
                            <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Estado" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Tabla Afectada" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Registros" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="Duración" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="Acciones" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- Lista de Tablas con Delta -->
                            <ListView x:Name="LvRunItems" Grid.Row="1" SelectionMode="None" Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="16,6" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:SyncRunItemViewModel">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Estado -->
                                            <Border Grid.Column="0" Background="{x:Bind StatusBackground}" BorderBrush="{x:Bind StatusBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="10" Foreground="{x:Bind StatusForeground}" />
                                                    <TextBlock Text="{x:Bind StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind StatusForeground}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Nombre de Tabla -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind TableName}" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI" FontSize="12" VerticalAlignment="Center" />

                                            <!-- Registros -->
                                            <TextBlock Grid.Column="2" Text="{x:Bind RecordsText}" HorizontalAlignment="Right" FontFamily="Consolas, Segoe UI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />

                                            <!-- Duración -->
                                            <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                            <!-- Acciones -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Button Click="BtnViewItemDetail_Click" Tag="{x:Bind}" Visibility="{x:Bind ErrorButtonVisibility}" Padding="8,3" Style="{StaticResource DefaultButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                        <TextBlock Text="Incidencia" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Text="Correcto" Visibility="{x:Bind OkTextVisibility}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Panel cuando la sincronización fue limpia (0 deltas) -->
                            <StackPanel x:Name="PnlNoItemChanges" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed" Padding="20">
                                <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Sincronización Limpia Sin Modificaciones" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Todas las tablas consultaron corte sin cambios en este ciclo. No hubo filas nuevas ni incidencias (0 deltas)." FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>