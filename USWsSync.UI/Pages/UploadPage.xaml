<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="USWsSync_UI.Pages.UploadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">
            <!-- Encabezado -->
            <StackPanel Spacing="4">
                <TextBlock Text="Subida de Datos" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Sincroniza información desde la Base Local (ERP) hacia la Nube (API Pública)." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Card de Parámetros de Sincronización -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Rango de Fechas" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Fecha Inicio:" FontWeight="SemiBold" />
                            <CalendarDatePicker x:Name="DpFechaInicio" HorizontalAlignment="Stretch" PlaceholderText="Seleccione fecha inicial" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Fecha Final:" FontWeight="SemiBold" />
                            <CalendarDatePicker x:Name="DpFechaFinal" HorizontalAlignment="Stretch" PlaceholderText="Seleccione fecha final" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Última fecha de envío de información:" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtLastDate" Text="---" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <!-- Botón de Acción -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BtnStart" Click="BtnStart_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xED25;" />
                                <TextBlock Text="Comenzar Subida" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnCancel" Click="BtnCancel_Click" IsEnabled="False" Content="Cancelar" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card de Progreso -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock x:Name="TxtCurrentTable" Text="Tabla: Ninguna en ejecución" FontWeight="SemiBold" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Left" />
                        <TextBlock x:Name="TxtProgressPct" Text="0%" FontWeight="Bold" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" />
                    </Grid>

                    <ProgressBar x:Name="PbSync" Value="0" Maximum="100" Height="14" CornerRadius="7" />

                    <TextBlock x:Name="TxtStatus" Text="Listo para iniciar" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Consola de Logs en Vivo -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Registro de Actividad" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ScrollViewer x:Name="LogScrollViewer" Height="200" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtLogs" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Background="Transparent" BorderThickness="0" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
